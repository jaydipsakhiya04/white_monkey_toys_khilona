// Khilona — database schema
// PostgreSQL + Prisma. Money is stored as DECIMAL(12,2) (INR).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────────────────────
// Admins & authentication
// ─────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens AdminRefreshToken[]
  statusChanges OrderStatusHistory[]
}

/// Rotating refresh tokens. Only a SHA-256 hash of the token is stored.
model AdminRefreshToken {
  id         String    @id @default(cuid())
  adminId    String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Store configuration (single row)
// ─────────────────────────────────────────────────────────────

model Store {
  id            String  @id @default(cuid())
  name          String
  tagline       String?
  description   String? @db.Text
  logoUrl       String?
  coverImageUrl String?

  phone         String?
  whatsapp      String?
  email         String?
  address       String? @db.Text
  city          String?
  state         String?
  pincode       String?
  googleMapLink String?

  instagram String?
  facebook  String?
  youtube   String?
  website   String?

  openingTime   String? // "10:00" (24h)
  closingTime   String? // "21:00" (24h)
  workingDays   String? // e.g. "Monday – Saturday"
  isOpen        Boolean @default(true)
  closedMessage String?

  // Storefront content
  heroTitle     String?
  heroSubtitle  String?
  heroCtaLabel  String?
  announcement  String?

  // Policies (shown in footer / policy pages)
  shippingPolicy     String? @db.Text
  returnPolicy       String? @db.Text
  privacyPolicy      String? @db.Text
  termsAndConditions String? @db.Text

  // SEO defaults
  seoTitle       String?
  seoDescription String?

  /// When true, new customer reviews wait for admin approval before they appear on the storefront.
  reviewsRequireApproval Boolean @default(false)

  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────

model Category {
  id             String   @id @default(cuid())
  parentId       String?
  name           String
  slug           String   @unique
  description    String?  @db.Text
  imageUrl       String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([isActive, sortOrder])
  @@index([parentId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Category_name_trgm_idx")
}

model Product {
  id               String    @id @default(cuid())
  categoryId       String
  name             String
  slug             String    @unique
  shortDescription String?
  description      String?   @db.Text
  sku              String?   @unique
  price            Decimal   @db.Decimal(12, 2)
  salePrice        Decimal?  @db.Decimal(12, 2)
  /// Lowest / highest effective selling price (sale ?? regular), across active variants when present. Maintained by the API.
  minPrice         Decimal   @default(0) @db.Decimal(12, 2)
  maxPrice         Decimal   @default(0) @db.Decimal(12, 2)
  /// For products with variants this is kept in sync as the sum of active variant stock.
  stock            Int       @default(0)
  lowStockThreshold Int      @default(5)
  thumbnailUrl     String?
  /// Free-form specification rows: [{ "label": "Age", "value": "3+" }]
  specifications   Json?
  hasVariants      Boolean   @default(false)
  isFeatured       Boolean   @default(false)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  seoTitle         String?
  seoDescription   String?
  /// Soft delete: products referenced by orders are never hard-deleted.
  deletedAt        DateTime?
  /// Average of APPROVED review ratings (0 when there are none). Maintained by the API.
  ratingAvg        Decimal   @default(0) @db.Decimal(3, 2)
  /// Number of APPROVED reviews. Maintained by the API.
  ratingCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  options    ProductOption[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([isActive, deletedAt])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([minPrice])
  @@index([sortOrder])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// An option group, e.g. "Color" or "Age".
model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
}

/// A single choice inside an option group, e.g. "Red".
model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option   ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@unique([optionId, value])
}

/// A purchasable combination of option values with its own price/stock/image.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  title     String // "Red / Large"
  sku       String?  @unique
  /// null => inherits the product price
  price     Decimal? @db.Decimal(12, 2)
  salePrice Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  imageUrl  String?
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductVariantOptionValue[]
  orderItems   OrderItem[]

  @@index([productId])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

// ─────────────────────────────────────────────────────────────
// Customers & orders
// ─────────────────────────────────────────────────────────────

/// Customers are identified by phone. A customer becomes a registered account once a
/// password is set (signup); guest checkout keeps working without one.
model Customer {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  /// Contact email (last one given at checkout for guests; the login email for accounts).
  email        String?
  /// Login email of a registered account (lowercase). Null for guest-only customers.
  accountEmail String?   @unique
  /// bcrypt hash. Null => guest-only customer (cannot sign in).
  passwordHash String?
  registeredAt DateTime?
  lastLoginAt  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders         Order[]
  refreshTokens  CustomerRefreshToken[]
  passwordResets CustomerPasswordReset[]
  reviews        Review[]
}

/// Rotating refresh tokens for customer accounts. Only a SHA-256 hash of the token is stored.
model CustomerRefreshToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

/// Single-use, short-lived password reset tokens (hash only).
model CustomerPasswordReset {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  customerId  String?
  status      OrderStatus @default(PENDING)

  // Customer snapshot
  customerName   String
  customerPhone  String
  alternatePhone String?
  customerEmail  String?

  // Delivery address snapshot
  address  String  @db.Text
  city     String
  state    String
  pincode  String
  landmark String?

  // Location
  locationLink   String?
  googleMapsLink String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)

  customerNote String? @db.Text
  adminNote    String? @db.Text

  // Totals (snapshot at time of purchase)
  itemsCount  Int
  subtotal    Decimal @db.Decimal(12, 2) // sum of regular price x qty
  discount    Decimal @db.Decimal(12, 2) // sum of (regular - sale) x qty
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(UNPAID)

  stockRestored Boolean   @default(false)
  /// Set when the order belongs to the customer's account (placed while signed in, or claimed
  /// with order number + the account's mobile). Only these orders appear under "My orders".
  accountLinkedAt DateTime?
  confirmedAt   DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  source    String   @default("WEB")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  history  OrderStatusHistory[]
  reviews  Review[]

  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerId])
  @@index([status, createdAt])
}

/// Immutable snapshot of what was bought. Survives product edits/deletion.
model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  productName  String
  productSlug  String?
  sku          String?
  variantTitle String?
  /// [{ "name": "Color", "value": "Red" }]
  options      Json?
  imageUrl     String?
  categoryName String?
  unitMrp      Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?
  changedById   String?
  changedByName String?
  createdAt     DateTime     @default(now())

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Admin? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

/// A verified-purchase review: only possible for a product in one of the customer's own
/// DELIVERED orders (enforced by the API). One review per customer + product + order.
model Review {
  id         String       @id @default(cuid())
  customerId String
  productId  String
  orderId    String
  rating     Int
  comment    String?      @db.Text
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, orderId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}

/// Per-day sequence used to build collision-safe order numbers (KH-YYYYMMDD-NNNN).
model OrderCounter {
  day   String @id // "20261002"
  value Int    @default(0)
}
