# ─── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API (used to build upload URLs for local storage)
APP_URL=http://localhost:4000
# Set to true when running behind a reverse proxy / load balancer (for correct client IPs)
TRUST_PROXY=false
SWAGGER_ENABLED=true

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khilona?schema=public

# ─── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Customer accounts (storefront) — refresh token lifetime and password-reset link lifetime
CUSTOMER_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Refresh token cookie (httpOnly). Use COOKIE_SECURE=true + HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── CORS ─────────────────────────────────────────────────
# Comma separated list of allowed origins (user panel + admin panel)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Public storefront URL (used to build password-reset links)
STOREFRONT_URL=http://localhost:3000

# ─── Business ─────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata
# Order numbers look like WMT-20261002-0001 (existing orders keep their numbers)
ORDER_NUMBER_PREFIX=WMT

# ─── Rate limiting (requests per minute per IP) ───────────
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_LOGIN_LIMIT=5
THROTTLE_ORDER_LIMIT=10
# Guest order tracking / document lookups
THROTTLE_TRACK_LIMIT=20

# ─── Storage ──────────────────────────────────────────────
# local  -> files written to STORAGE_LOCAL_DIR and served at {APP_URL}/uploads
# s3     -> any S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, DO Spaces…)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
# Public base URL for stored files (CDN). Defaults to {APP_URL}/uploads for local storage.
STORAGE_PUBLIC_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
UPLOAD_MAX_FILE_SIZE_MB=5
