# Public REST API base URL (browser + server)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Public URL of this storefront (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: internal API URL used by server components (falls back to NEXT_PUBLIC_API_URL)
API_URL=
# Optional: comma-separated extra image hostnames (S3 bucket, CDN...)
NEXT_PUBLIC_IMAGE_HOSTS=
