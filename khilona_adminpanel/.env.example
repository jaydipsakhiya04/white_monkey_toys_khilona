# Base URL of the Khilona REST API (includes /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional: public storefront URL used for "View on store" links
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# Optional: comma separated list of image hosts (informational; admin uses plain <img>)
NEXT_PUBLIC_IMAGE_HOSTS=localhost
